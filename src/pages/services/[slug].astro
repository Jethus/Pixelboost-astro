---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ClosingCTA from "../../components/ClosingCTA.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Button from "../../components/ui/Button.astro";

export async function getStaticPaths() {
  const servicesDocs = await getCollection("services");

  return servicesDocs.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout
  title={`${service.data.tab}`}
  description={(service.body ?? "").substring(0, 150)}
>
  <Header />

  <main>
    <section class="section-card surface-paper">
      <Eyebrow label="Service details" />
      <h1 class="service-detail-h1">{service.data.tab}</h1>
      <p class="section-subhead service-detail-subhead">
        {service.body}
      </p>
      <div class="service-detail-cta">
        <Button href="/#services" variant="outline">Back to services</Button>
      </div>
    </section>
  </main>

  <ClosingCTA />
  <Footer />
</BaseLayout>

<style>
  .service-detail-h1 {
    margin: 20px 0 24px 0;
    max-width: 18ch;
  }

  .service-detail-subhead { max-width: 60ch; }

  .service-detail-cta { margin-top: 32px; }
</style>
