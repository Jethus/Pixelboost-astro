---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout title="Services">
  <Header />
  <main>
    <section class="section-card" style="background: var(--color-paper);">
      <Eyebrow label="Coming soon" />
      <h1 style="margin: 20px 0 20px 0; max-width: 16ch;">Services</h1>
      <p class="section-subhead">
        I'm building out this page. In the meantime, see what I offer on the home page.
      </p>
      <div style="margin-top: 28px;">
        <Button href="/#services" variant="outline">View services</Button>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
