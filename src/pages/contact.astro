---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Josh at Pixelboost. Custom web design for small businesses in Toronto and Durham Region."
>
  <Header />

  <main>

    <section class="section-card surface-paper">
      <Eyebrow label="Contact" />
      <h1 class="contact-hero-h1">Let's talk about your site.</h1>
      <p class="contact-hero-lead">
        No pressure, no sales pitch. Just tell me what you're working on and I'll let you know if I can help.
      </p>
    </section>

    <section class="section-card surface-paper-2">
      <div class="contact-grid">

        <div class="contact-info-col">
          <div class="contact-method">
            <span class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <div>
              <p class="contact-label">Email</p>
              <a href="mailto:hello@pixelboost.ca" class="contact-value">hello@pixelboost.ca</a>
            </div>
          </div>

          <div class="contact-method">
            <span class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.7 10a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.66 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 5.49 5.49l1.04-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div>
              <p class="contact-label">Phone</p>
              <a href="tel:+19057812464" class="contact-value">(905) 781-2464</a>
            </div>
          </div>

          <div class="contact-method">
            <span class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <p class="contact-label">Based in</p>
              <p class="contact-value contact-value-muted">Toronto, Ontario. Serving the GTA and Durham Region</p>
            </div>
          </div>
        </div>

        <form class="contact-form" name="contact" method="POST" action="/contact">
          {/* Static build: ?sent / ?error can't be read at build time, so both
              banners ship hidden and the inline script below reveals one. */}
          <p id="form-status-sent" class="form-status form-status-success" role="status" hidden>
            Thanks. Your message has been sent.
          </p>

          <p id="form-status-error" class="form-status form-status-error" role="alert" hidden>
            Something went wrong. Please email hello@pixelboost.ca directly.
          </p>

          <div class="field-group">
            <label for="name" class="field-label">Your name</label>
            <input type="text" id="name" name="name" required placeholder="Jane Smith" class="field-input" />
          </div>

          <div class="field-group">
            <label for="email" class="field-label">Email address</label>
            <input type="email" id="email" name="email" required placeholder="jane@yourbusiness.ca" class="field-input" />
          </div>

          <div class="field-group">
            <label for="website" class="field-label">Your current website <span class="field-optional">(optional)</span></label>
            <input type="text" id="website" name="website" placeholder="yourbusiness.ca" class="field-input" />
          </div>

          <div class="field-group">
            <label for="message" class="field-label">What are you working on?</label>
            <textarea id="message" name="message" required rows="5" placeholder="Tell me a bit about your business and what you're looking for..." class="field-input field-textarea"></textarea>
          </div>

          <div class="turnstile-wrap">
            <div class="cf-turnstile" data-turnstile-sitekey data-sitekey={turnstileSiteKey}></div>
          </div>

          <button type="submit" class="submit-btn btn-mint btn-interactive">Send message <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></button>
        </form>

      </div>
    </section>

  </main>

  <Footer />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    var site = sessionStorage.getItem('pb_audit_url');
    var email = sessionStorage.getItem('pb_audit_email');
    if (site) { var w = document.getElementById('website'); if (w) w.value = site; }
    if (email) { var em = document.getElementById('email'); if (em) em.value = email; }

    var params = new URLSearchParams(location.search);
    if (params.has('sent')) {
      var ok = document.getElementById('form-status-sent');
      if (ok) ok.hidden = false;
      (window.plausible || function(){}).call(window, "Contact Form Submitted");
    }
    if (params.has('error')) {
      var err = document.getElementById('form-status-error');
      if (err) err.hidden = false;
    }
  </script>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    max-width: 900px;
  }
  @media (max-width: 720px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-method {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    color: var(--color-mint-700);
    flex-shrink: 0;
  }

  .contact-label {
    margin: 0 0 3px 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-400);
  }

  .contact-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.15s;
    margin: 0;
    display: block;
  }
  a.contact-value:hover { color: var(--color-mint-600); }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-status {
    margin: 0;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .form-status-success {
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    color: var(--color-mint-700);
  }

  .form-status-error {
    background: #fff2f0;
    border: 1px solid #ffd2cc;
    color: #8f1f12;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .field-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .field-input {
    font-family: inherit;
    font-size: 15px;
    padding: 12px 16px;
    background: var(--color-paper);
    border: 1.5px solid var(--color-line);
    border-radius: 10px;
    color: var(--color-ink);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
    box-sizing: border-box;
  }
  .field-input:focus {
    border-color: var(--color-mint-500);
    box-shadow: 0 0 0 3px var(--color-mint-100);
  }
  .field-input::placeholder { color: var(--color-ink-400); }

  .field-textarea {
    resize: vertical;
    min-height: 130px;
    line-height: 1.6;
  }

  .turnstile-wrap {
    min-height: 65px;
    display: flex;
    align-items: center;
  }

  .submit-btn {
    align-self: flex-start;
    font-family: inherit;
    cursor: pointer;
  }

  .contact-hero-h1 {
    margin: 0 0 20px 0;
    max-width: 16ch;
  }

  .contact-hero-lead {
    font-size: clamp(16px, 1.35vw, 19px);
    color: var(--color-ink-500);
    line-height: 1.5;
    max-width: 52ch;
    margin: 0;
    font-weight: 500;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact-value-muted { color: var(--color-ink-700); }

  .field-optional {
    color: var(--color-ink-400);
    font-weight: 400;
  }
</style>
