---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/ui/BlogCard.astro";
import FeaturedBlogCard from "../../components/ui/FeaturedBlogCard.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import ClosingCTA from "../../components/ClosingCTA.astro";
import { readTime } from "../../lib/read-time";

// Sort by effective date (updatedDate falls back to pubDate) so a refreshed
// post resurfaces near the top, in step with search-engine freshness weighting.
const sortDate = (p) => (p.data.updatedDate ?? p.data.pubDate).valueOf();
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => sortDate(b) - sortDate(a));

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Blog"
  description="Practical web advice for small business owners: speed, SEO, accessibility, and what actually makes a site work."
>
  <Header />

  <main>

    <section class="section-card surface-paper blog-hero">
      <Eyebrow label="Blog" />
      <h1 class="blog-hero-h1">Practical web advice for small businesses.</h1>
      <p class="section-subhead">
        Speed, SEO, accessibility: the stuff that actually affects whether your site works for your customers.
      </p>
    </section>

    <section class="section-card surface-paper-2">
      {posts.length === 0 ? (
        <p class="blog-empty">No posts yet. Check back soon.</p>
      ) : (
        <>
          {featured && (
            <FeaturedBlogCard
              title={featured.data.title}
              description={featured.data.description}
              pubDate={featured.data.pubDate}
              updatedDate={featured.data.updatedDate}
              readTime={readTime(featured.body)}
              slug={featured.id}
            />
          )}

          {rest.length > 0 && (
            <div class="blog-grid">
              {rest.map((post, i) => (
                <div data-reveal>
                  <BlogCard
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    updatedDate={post.data.updatedDate}
                    readTime={readTime(post.body)}
                    slug={post.id}
                  />
                </div>
              ))}
            </div>
          )}
        </>
      )}
    </section>

    <ClosingCTA />

  </main>

  <Footer />
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .blog-grid { grid-template-columns: 1fr; } }

  .blog-hero {
    padding-top: clamp(40px, 5vw, 64px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .blog-hero-h1 {
    margin: 0 0 20px 0;
    max-width: 18ch;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .blog-empty { color: var(--color-ink-500); }

  .blog-grid > [data-reveal]:nth-child(1) { --reveal-i: 1; }
  .blog-grid > [data-reveal]:nth-child(2) { --reveal-i: 2; }
  .blog-grid > [data-reveal]:nth-child(3) { --reveal-i: 3; }
  .blog-grid > [data-reveal]:nth-child(4) { --reveal-i: 4; }
  .blog-grid > [data-reveal]:nth-child(5) { --reveal-i: 5; }
  .blog-grid > [data-reveal]:nth-child(6) { --reveal-i: 6; }
</style>
