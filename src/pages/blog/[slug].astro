---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogFAQ from "../../components/BlogFAQ.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const postUrl = new URL(`/blog/${post.id}`, Astro.site).href;

const blogPostingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  author: { "@type": "Person", name: "Josh Del Vecchio" },
  publisher: {
    "@type": "Organization",
    name: "Pixelboost",
    url: "https://pixelboost.ca",
  },
  mainEntityOfPage: postUrl,
};

const faq = post.data.faq;
const faqLd = faq && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
  {faqLd && (
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  )}

  <Header />

  <main>

    <section class="section-card surface-paper">
      <p class="post-eyebrow">{formattedDate}</p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-description">
        {post.data.description}
      </p>
    </section>

    <section class="section-card surface-paper-2">
      <article class="post-body post-body-width">
        <Content />

        {faq && <BlogFAQ questions={faq} />}
      </article>

      <div class="post-footer">
        <a
          href="/blog"
          class="back-link"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          Back to blog
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .post-title {
    margin: 0 0 20px 0;
    max-width: 22ch;
  }

  .post-description {
    font-size: clamp(16px, 1.35vw, 19px);
    color: var(--color-ink-500);
    line-height: 1.5;
    max-width: 56ch;
    margin: 0;
    font-weight: 500;
  }

  .post-body-width { max-width: 68ch; }

  .post-footer {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mint-600);
    margin: 0 0 20px 0;
  }

  .back-link:hover { color: var(--color-mint-600); }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .post-body :global(p) {
    margin-bottom: 1.35rem;
    line-height: 1.75;
    color: var(--color-ink-700);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
    color: var(--color-ink-700);
  }

  .post-body :global(li) { margin-bottom: 0.4rem; line-height: 1.65; }
  .post-body :global(ul) { list-style-type: disc; }
  .post-body :global(ol) { list-style-type: decimal; }

  .post-body :global(strong) { color: var(--color-ink); font-weight: 700; }

  .post-body :global(blockquote) {
    position: relative;
    border-left: 4px solid var(--color-mint-500);
    padding: 28px 32px 28px 36px;
    margin: 2.25rem 0;
    background: var(--color-mint-50);
    border-radius: 0 14px 14px 0;
    color: var(--color-ink);
  }

  /* Oversized quote mark in the accent, sitting behind the text */
  .post-body :global(blockquote)::before {
    content: "\201C";
    position: absolute;
    top: 0.18em;
    right: 0.28em;
    font-size: 5.5rem;
    line-height: 1;
    color: var(--color-mint-200);
    pointer-events: none;
    z-index: 0;
  }

  .post-body :global(blockquote p) {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .post-body :global(code) {
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.875em;
    color: var(--color-ink);
  }

  .post-body :global(pre) {
    background: var(--color-ink);
    color: var(--color-paper);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.35rem;
  }

  .post-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875em;
  }

  /* prose link styles handled globally via .post-body a in global.css */

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: 2.5rem 0;
  }

  /* Prose tables styled globally via .post-body table in global.css */
</style>
