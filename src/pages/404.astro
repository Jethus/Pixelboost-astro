---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist. Head back to the homepage or get in touch."
>
  <Header />

  <main>
    <section class="section-card not-found">
      <Eyebrow label="404" />
      <h1 class="not-found-h1">This page doesn't exist</h1>
      <p class="not-found-lead">
        The link you followed is broken, or the page has moved. Either way, nothing to see here — but the rest of the site is working fine.
      </p>
      <div class="not-found-actions">
        <Button href="/">Back to the homepage</Button>
        <Button href="/blog" variant="outline" arrow={false}>Read the blog</Button>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(80px, 12vw, 160px);
    padding-bottom: clamp(80px, 12vw, 160px);
  }

  .not-found-h1 {
    margin: 24px 0 20px 0;
    line-height: 1.05;
  }

  .not-found-lead {
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--color-ink-500);
    line-height: 1.65;
    margin: 0 0 36px 0;
    font-weight: 500;
    max-width: 46ch;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
</style>
