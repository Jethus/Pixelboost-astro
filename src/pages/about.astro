---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import joshPhoto from "../assets/webp/Josh-crop.webp";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";

const facts = [
  {
    label: "Based in",
    value: "Toronto, Ontario. Working with clients across the GTA and Durham Region.",
  },
  {
    label: "Background",
    value: "Frontend dev with 4+ years experience. TypeScript, React, modern CSS, and a design background before all that.",
  },
  {
    label: "What I actually care about",
    value: "Sites that perform: fast load times, good Core Web Vitals, clean structure. Every site I ship reflects on me, so I don't cut corners.",
  },
  {
    label: "How I work",
    value: "Directly with you. No handoffs to junior staff, no project managers in between.",
  },
];
---

<BaseLayout
  title="About"
  description="I'm Josh, a web designer and developer based in Ontario. Here's a bit about who I am and how Pixelboost came to be."
>
  <Header />

  <main>

    <!-- Hero -->
    <section class="section-card about-hero">
      <div class="about-hero-text">
        <Eyebrow label="About" />
        <h1 class="about-hero-h1">Hey, I'm Josh.</h1>
        <p class="about-hero-lead">
          I'm a frontend developer with a background in design. I build websites for small businesses in Ontario. Not templates, actual custom sites that load fast and look like they belong to you.
        </p>
      </div>
      <div class="about-hero-photo">
        <Image
          src={joshPhoto}
          alt="Josh Del Vecchio"
          width={600}
          height={720}
          class="about-hero-img"
        />
      </div>
    </section>

    <!-- Story -->
    <section class="section-card surface-paper-2 about-story">
      <div>
        <h2 class="about-story-h2">How this started</h2>
        <div class="about-story-body">
          <p class="about-story-p">
            I've spent more than four years building accessible, responsive web tools professionally — these days at the Ontario College of Teachers, where the sites I work on have to hold up for a lot of people, on every device, no exceptions. That's also where I learned <a class="prose-link" href="/blog/web-accessibility-small-business-ontario">what Ontario's AODA accessibility rules actually require of a website</a>, working through a real remediation against the standard the law references. Before development I came up through design, so I care about how things look just as much as how they work.
          </p>
          <p class="about-story-p">
            I started Pixelboost because I kept seeing the same thing: small businesses with great products or services, stuck with websites that were slow, clunky, or just kind of embarrassing. The kind of site that makes people leave before they've even read a sentence.
          </p>
          <p class="about-story-p">
            Most of those businesses had either been quoted a fortune by an agency or tried DIY and hit a wall. Pixelboost sits in between: custom-built sites, real code, at a price that actually makes sense if you're running a small business.
          </p>
          <p class="about-story-p">
            The thing is, every site I build reflects on me too. So I'm not looking to ship something that's just "good enough." I want it to actually perform: load fast, rank well, convert visitors into customers. The stuff I talk about in audits and on this site isn't filler. Speed, accessibility, structure, Core Web Vitals: I genuinely think these things matter, and I build with all of it in mind from the start.
          </p>
        </div>
      </div>

      <aside class="about-facts" aria-label="Quick facts">
        {facts.map((fact) => (
          <div class="about-fact">
            <p class="about-fact-label">{fact.label}</p>
            <p class="about-fact-value">{fact.value}</p>
          </div>
        ))}
      </aside>
    </section>

    <!-- What I actually do -->
    <section class="section-card surface-paper">
      <div class="about-services-intro">
        <h2 class="about-services-h2">What I actually do</h2>
        <p class="about-services-lead">
          Most of my clients come to me with one of a few situations: they need a new site built from scratch, their current site is slow and outdated, or they've outgrown their DIY setup and need something real.
        </p>
      </div>

      <div class="services-grid">
        <div class="service-item">
          <h3>Web Design & Development</h3>
          <p>Custom sites built in code, not drag-and-drop builders. Designed to match your brand and built to perform.</p>
        </div>
        <div class="service-item">
          <h3>Website Redesigns</h3>
          <p>If your current site is holding you back, I can rebuild it properly, keeping what matters, fixing what doesn't.</p>
        </div>
        <div class="service-item">
          <h3>Search Engine Optimization</h3>
          <p>Technical SEO is baked in from the start: fast load times, clean markup, structured data, the works.</p>
        </div>
        <div class="service-item">
          <h3>Ongoing Maintenance</h3>
          <p>Monthly plan clients get updates, edits, and support included. You don't need to stress about the technical side.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-card surface-ink about-cta">
      <div>
        <h2 class="about-cta-h2">Want to work together?</h2>
        <p class="about-cta-p">
          No pressure, no sales pitch. Just tell me what you're working on and we'll figure out if it's a good fit.
        </p>
      </div>
      <Button href="/contact" variant="mint">Get in touch</Button>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    max-height: clamp(360px, 40vw, 520px);
    background: var(--color-paper);
    overflow: hidden;
    padding: 0 !important; /* section-card padding handled by text column */
  }

  .about-story {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  @media (max-width: 720px) {
    .about-story { grid-template-columns: 1fr; }
  }

  .about-hero-text {
    padding: clamp(64px, 9vw, 120px) clamp(28px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-hero-photo {
    overflow: hidden;
  }

  .about-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  @media (max-width: 720px) {
    .about-hero {
      grid-template-columns: 1fr;
      max-height: none;
    }
    .about-hero-photo {
      height: 320px;
      border-radius: 0 0 var(--radius-section) var(--radius-section);
    }
  }

  /* Magazine-sidebar fact rail: one hairline down the left edge, small-caps
     labels, generous air — no boxes, no icons. */
  .about-facts {
    border-left: 1px solid var(--color-line-2);
    padding-left: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 28px;
    /* Ride along with the story column; 120px clears the sticky header pill.
       (Inert in the single-column mobile layout — no travel room.) */
    position: sticky;
    top: 120px;
  }

  .about-fact-label {
    margin: 0 0 4px 0;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    /* ink-500, not ink-400: 11.5px text on paper-2 needs AA contrast. */
    color: var(--color-ink-500);
  }

  .about-fact-value {
    margin: 0;
    font-size: clamp(14.5px, 1.1vw, 15.5px);
    line-height: 1.6;
    color: var(--color-ink-700);
    font-weight: 500;
  }

  /* Ruled two-column list — no boxed grid. */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(36px, 5vw, 72px);
    border-top: 1px solid var(--color-line);
  }

  .service-item {
    padding: 26px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .service-item h3 {
    margin: 0 0 8px 0;
    font-size: clamp(15px, 1.2vw, 17px);
    font-weight: 700;
    color: var(--color-ink);
  }

  .service-item p {
    margin: 0;
    font-size: clamp(16px, 1.25vw, 17px);
    color: var(--color-ink-700);
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .services-grid { grid-template-columns: 1fr; }
    .service-item:last-child { border-bottom: none; }
  }

  .about-hero-h1 {
    margin: 0 0 24px 0;
    line-height: 1.05;
    white-space: nowrap;
  }

  .about-hero-lead {
    font-size: clamp(17px, 1.5vw, 21px);
    color: var(--color-ink-500);
    line-height: 1.65;
    margin: 0;
    font-weight: 500;
    max-width: 60ch;
  }

  .about-story-h2 {
    margin: 0 0 24px 0;
    font-size: clamp(24px, 2.5vw, 32px);
  }

  .about-story-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: clamp(16px, 1.25vw, 17.5px);
    color: var(--color-ink-700);
    line-height: 1.75;
  }

  .about-story-p { margin: 0; }

  .about-services-intro {
    max-width: 680px;
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .about-services-h2 {
    margin: 0 0 16px 0;
    font-size: clamp(24px, 2.5vw, 32px);
  }

  .about-services-lead {
    margin: 0;
    font-size: clamp(16px, 1.25vw, 17.5px);
    color: var(--color-ink-700);
    line-height: 1.7;
  }

  .about-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
  }

  .about-cta-h2 {
    margin: 0 0 10px 0;
    color: var(--color-paper);
    font-size: clamp(22px, 2.2vw, 30px);
  }

  .about-cta-p {
    margin: 0;
    color: rgba(248,245,238,0.65);
    font-size: 15px;
    max-width: 44ch;
    line-height: 1.55;
  }

</style>
