---
import ComparisonTable from "./ui/ComparisonTable.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const rows = [
  {
    feature: "How your site looks",
    diy: "Template look shared by many businesses",
    ours: "Designed around your brand from scratch",
  },
  {
    feature: "Speed on mobile",
    diy: "Often slowed down by page-builder weight",
    ours: "Built to feel fast on real phones",
  },
  {
    feature: "Security & maintenance",
    diy: "Plugin updates and surprise maintenance",
    ours: "No plugin stack to babysit",
  },
  {
    feature: "Accessibility (Ontario law)",
    diy: "Often treated as an afterthought",
    ours: "Built with AODA expectations in mind",
  },
  {
    feature: "Knowing where leads come from",
    diy: "Nothing, or a confusing analytics setup",
    ours: "Simple lead and traffic dashboard, set up and explained",
  },
];
---

<section id="compare" class="section-card surface-paper">
  <SectionHeader eyebrow="Template vs custom" subhead="A template can get you online. A custom rebuild is for when the site needs to be faster, clearer, and easier to measure.">
    How a custom rebuild compares.
  </SectionHeader>

  <div class="compare-table-wrap">
    <ComparisonTable
      columns={["Feature", "Page builders", "A custom rebuild"]}
      rows={rows.map((row) => [row.feature, row.diy, row.ours]) as [
        string,
        string,
        string,
      ][]}
    />
  </div>
</section>

<style>
  .compare-table-wrap { margin-top: 36px; }
</style>
