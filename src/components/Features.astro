---
import SectionHeader from "./ui/SectionHeader.astro";
const pillars = [
  {
    title: "Opens fast on a phone.",
    pitch: "Your site should load in about a second, even on slow data, so people don't give up and leave.",
    proof: "I aim for 95+ on Google's speed score and show you the result before launch.",
  },
  {
    title: "Easy for every customer to use.",
    pitch: "Clear text, buttons that are easy to tap, and a layout that doesn't break — on any phone or screen.",
    proof: "Built to Ontario's AODA accessibility standard and checked by hand, not just automated tools.",
  },
  {
    title: "See what's actually bringing in customers.",
    pitch: "Know which pages, Google searches, and ads are sending you calls and enquiries — so you stop guessing.",
    proof: "Simple, private analytics. No data selling, no confusing dashboard.",
  },
  {
    title: "I'm still your developer after launch.",
    pitch: "Need hours changed, a service added, or a photo swapped? Just send it.",
    proof: "Small updates are included in the monthly plan. Most are done within the week.",
  },
];

---

<section class="section-card surface-paper">
  <div data-reveal>
    <SectionHeader eyebrow="What you actually get" subhead="Better design, faster pages, clearer analytics, and someone to call when the site needs changing.">
      What I fix when I rebuild your site.
    </SectionHeader>
  </div>

  <ol class="fix-list">
    {pillars.map((p, i) => (
      <li class="fix-row" data-reveal>
        <span class="fix-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <div class="fix-body">
          <h3 class="fix-title">{p.title}</h3>
          <p class="fix-pitch">{p.pitch}</p>
          <p class="fix-proof">
            <span class="fix-proof-tag">Proof</span>
            <span class="fix-proof-text">{p.proof}</span>
          </p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .fix-list {
    list-style: none;
    margin: 36px 0 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .fix-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: 28px;
    align-items: start;
    padding: 28px 4px;
    border-bottom: 1px solid var(--color-line);
  }

  .fix-num {
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-mint-200);
    font-variant-numeric: tabular-nums;
  }

  .fix-body { display: flex; flex-direction: column; gap: 8px; }

  .fix-title {
    margin: 0;
    font-size: clamp(18px, 1.45vw, 22px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .fix-pitch {
    margin: 0;
    font-size: clamp(14.5px, 1.1vw, 16.5px);
    color: var(--color-ink-500);
    line-height: 1.55;
    max-width: 60ch;
  }

  .fix-proof {
    margin: 4px 0 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .fix-proof-tag {
    flex-shrink: 0;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mint-700);
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    line-height: 1.4;
  }

  .fix-proof-text {
    font-size: 13px;
    color: var(--color-ink-500);
    line-height: 1.5;
  }

  .fix-row:nth-child(1) { --reveal-i: 1; }
  .fix-row:nth-child(2) { --reveal-i: 2; }
  .fix-row:nth-child(3) { --reveal-i: 3; }
  .fix-row:nth-child(4) { --reveal-i: 4; }

  @media (max-width: 600px) {
    .fix-row {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: 16px;
      padding: 22px 2px;
    }
    .fix-num { font-size: 30px; }
  }
</style>
