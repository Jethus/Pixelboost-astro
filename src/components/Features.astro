---
import SectionHeader from "./ui/SectionHeader.astro";
const pillars = [
  {
    title: "Fast on mobile.",
    pitch: "Your site should feel quick on a phone, even on a slow connection.",
    proof: "I target 95+ on Google PageSpeed and show you the result before launch.",
  },
  {
    title: "Works for every customer.",
    pitch: "Clear text, easy taps, strong contrast, and layouts that do not break.",
    proof: "Built toward Ontario AODA expectations and checked beyond automated scores.",
  },
  {
    title: "You can see where your leads come from.",
    pitch: "See which pages, searches, and campaigns are sending people your way.",
    proof: "Simple, private analytics. No data selling, no noisy dashboard.",
  },
  {
    title: "I'm still your developer after launch.",
    pitch: "Need hours changed, a service added, or a photo swapped? Just send it.",
    proof: "Small updates are included in the monthly plan. Most are done within the week.",
  },
];

const icons = [
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="4" r="1"/><path d="m18 19 1-7-5.87.94"/><path d="m5 8 3-3 5.5 1.5"/><path d="M4.24 14.5a5 5 0 0 0 6.88 6"/><path d="M13.76 17.5a5 5 0 0 0-6.88-6"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
];
---

<section class="section-card" style="background: var(--color-paper);">
  <div data-reveal>
    <SectionHeader eyebrow="What you actually get" subhead="Better design, faster pages, clearer analytics, and someone to call when the site needs changing.">
      What I fix when I rebuild your site.
    </SectionHeader>
  </div>

  <ol class="fix-list">
    {pillars.map((p, i) => (
      <li class="fix-row" data-reveal style={`--reveal-i: ${i + 1}`}>
        <span class="fix-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <div class="fix-body">
          <div class="fix-head">
            <span class="fix-icon" aria-hidden="true" set:html={icons[i]} />
            <h3 class="fix-title">{p.title}</h3>
          </div>
          <p class="fix-pitch">{p.pitch}</p>
          <p class="fix-proof">
            <span class="fix-proof-tag">Proof</span>
            <span class="fix-proof-text">{p.proof}</span>
          </p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .fix-list {
    list-style: none;
    margin: 36px 0 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .fix-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: 28px;
    align-items: start;
    padding: 28px 4px;
    border-bottom: 1px solid var(--color-line);
    transition: background 0.18s ease;
  }
  .fix-row:hover { background: var(--color-paper-2); }

  .fix-num {
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-mint-200);
    font-variant-numeric: tabular-nums;
  }
  .fix-row:hover .fix-num { color: var(--color-mint-500); }

  .fix-body { display: flex; flex-direction: column; gap: 8px; }

  .fix-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .fix-icon {
    color: var(--color-mint-600);
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
  }
  .fix-icon :global(svg) { width: 18px; height: 18px; }

  .fix-title {
    margin: 0;
    font-size: clamp(18px, 1.45vw, 22px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .fix-pitch {
    margin: 0;
    font-size: clamp(14.5px, 1.1vw, 16.5px);
    color: var(--color-ink-500);
    line-height: 1.55;
    max-width: 60ch;
  }

  .fix-proof {
    margin: 4px 0 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .fix-proof-tag {
    flex-shrink: 0;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mint-700);
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    line-height: 1.4;
  }

  .fix-proof-text {
    font-size: 13px;
    color: var(--color-ink-500);
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .fix-row {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: 16px;
      padding: 22px 2px;
    }
    .fix-num { font-size: 30px; }
  }
</style>
