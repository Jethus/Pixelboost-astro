---
import SectionHeader from "./ui/SectionHeader.astro";
const pillars = [
  {
    title: "Customers reach your contact page.",
    pitch: "A slow page loses people in the first second. A fast one means they stay long enough to see what you offer.",
    validation: "Pages load fast, so visitors don't bounce. I test it and show you the numbers.",
  },
  {
    title: "You know which calls are coming from your site.",
    pitch: "Right now you might be guessing whether your site is bringing in work. Simple tracking tells you which pages and searches are actually sending people your way.",
    validation: "Private analytics, no data selling, no confusing dashboard. Just the numbers that matter to your business.",
  },
  {
    title: "Your site stays current without you chasing anyone.",
    pitch: "Hours change. Services change. You shouldn't need a back-and-forth every time. Just send the update and it's handled.",
    validation: "Small updates are included in the monthly plan. Done within the week.",
  },
  {
    title: "Every customer can use your site, no matter what device they're on.",
    pitch: "If your layout breaks, text is too small, or buttons are hard to tap, people leave without telling you why. A properly built site just works.",
    validation: "Built to Ontario's accessibility standard. Checked with automated tools, verified by hand.",
  },
];

---

<section class="section-card surface-paper">
  <div data-reveal>
    <SectionHeader eyebrow="What you get" subhead="Better design, faster pages, clear analytics, and someone you can actually call when the site needs updating.">
      What's different after we launch.
    </SectionHeader>
  </div>

  <ul class="fix-list">
    {pillars.map((p) => (
      <li class="fix-row" data-reveal>
        <div class="fix-body">
          <h3 class="fix-title">{p.title}</h3>
          <p class="fix-pitch">{p.pitch}</p>
          <p class="fix-validation">
            <span class="fix-validation-tag">How I verify</span>
            <span class="fix-validation-text">{p.validation}</span>
          </p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .fix-list {
    list-style: none;
    margin: 36px 0 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .fix-row {
    padding: 28px 4px;
    border-bottom: 1px solid var(--color-line);
  }

  .fix-body { display: flex; flex-direction: column; gap: 8px; }

  .fix-title {
    margin: 0;
    font-size: clamp(18px, 1.45vw, 22px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .fix-pitch {
    margin: 0;
    font-size: clamp(14.5px, 1.1vw, 16.5px);
    color: var(--color-ink-500);
    line-height: 1.55;
    max-width: 60ch;
  }

  .fix-validation {
    margin: 4px 0 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .fix-validation-tag {
    flex-shrink: 0;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mint-700);
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    line-height: 1.4;
  }

  .fix-validation-text {
    font-size: 13px;
    color: var(--color-ink-500);
    line-height: 1.5;
  }

  .fix-row:nth-child(1) { --reveal-i: 1; }
  .fix-row:nth-child(2) { --reveal-i: 2; }
  .fix-row:nth-child(3) { --reveal-i: 3; }
  .fix-row:nth-child(4) { --reveal-i: 4; }

  @media (max-width: 600px) {
    .fix-row { padding: 22px 2px; }
  }
</style>
