---
import SectionHeader from "./ui/SectionHeader.astro";

interface QA { q: string; a: string; }
interface Props {
  heading?: string;
  /** Q&A list. Defaults to the home copy. */
  questions?: QA[];
}

const {
  heading = "Reasonable questions, plain answers.",
  questions = [
  {
    q: "How long does a project take?",
    a: "Most small-business sites take 4-6 weeks from kickoff. Larger sites or projects where I write the content can take a bit longer. I only take on two projects at a time so timelines stay honest.",
  },
  {
    q: "What's included in the $200/month plan?",
    a: "The full custom build, hosting, SSL, analytics, and ongoing small updates. Copy changes, new photos, simple page edits, and quick fixes are included. Bigger new features are quoted first.",
  },
  {
    q: "Am I locked into a contract?",
    a: "No. The monthly plan is month-to-month after the initial 12 months. If you leave, I help move the site wherever you want.",
  },
  {
    q: "Who owns the website?",
    a: "You do. The code, design, content, domain, and analytics are yours.",
  },
  {
    q: "What if I already have a site?",
    a: "Start with the free scan above. Sometimes the answer is \"your site is mostly fine; fix these 3 things.\" If a redesign makes sense, we talk through it.",
  },
  {
    q: "What does my site score mean?",
    a: "Google Lighthouse scores speed, accessibility, SEO, and best practices from 0 to 100. A score over 90 is strong. Below 50 usually means visitors are feeling the problem, even if they can't name it.",
  },
  {
    q: "Do you work with businesses outside Toronto?",
    a: "Yes. I mainly work with Toronto, Oshawa, Ajax, Pickering, and Durham Region businesses, but remote work across Ontario or Canada is fine.",
  },
  {
    q: "How much does a website redesign cost in Toronto?",
    a: "My monthly plan is $200/month for the build plus ongoing updates. The flat-rate option is $3,200 for a clean hand-off. Both are shown above with no hidden fees.",
  },
  {
    q: "What tools do you actually use?",
    a: "Lighthouse for Google PageSpeed-style scoring, and Plausible for simple privacy-friendly analytics. You get access to the dashboards too.",
  },
  ],
}: Props = Astro.props;
---

<section id="faq" class="section-card faq-section">
  <SectionHeader eyebrow="FAQ" maxWidth="narrow">
    {heading}
  </SectionHeader>

  <div class="faq-list">
    {questions.map((item, i) => (
      <details class="faq-item" open={i === 0}>
        <summary class="faq-q">{item.q}</summary>
        <div class="faq-a">{item.a}</div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section { background: var(--color-paper-2); }

  .faq-list {
    max-width: 760px;
    margin-top: 32px;
    border-top: 1px solid var(--color-line);
  }

  .faq-item { border-bottom: 1px solid var(--color-line); padding: 20px 0; }

  .faq-q {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    cursor: pointer; font-size: 17px; font-weight: 600; letter-spacing: -0.01em;
    list-style: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: "+";
    font-size: 20px;
    font-weight: 400;
    color: var(--color-ink-500);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    transform-origin: 50% 50%;
    transition: transform 0.2s ease;
    line-height: 1;
    padding-bottom: 1px;
  }
  .faq-item[open] .faq-q::after { transform: rotate(45deg); }

  .faq-a {
    margin-top: 10px;
    font-size: 14.5px; color: var(--color-ink-500); line-height: 1.6;
    max-width: 64ch;
  }
</style>
