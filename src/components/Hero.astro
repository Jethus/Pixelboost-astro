---
import Button from "./ui/Button.astro";
---

<section class="hero section-card surface-paper">
  <div aria-hidden="true" class="hero-blob hero-blob--lg"></div>
  <div aria-hidden="true" class="hero-blob hero-blob--sm"></div>

  <div class="hero-inner">
    <div>
      <h1 class="hero-title">
        Websites that <span class="high">actually work</span> for your small business.
      </h1>
      <p class="hero-sub">
        I redesign slow or dated websites for small businesses in Toronto and Durham, then set up simple analytics so you can see what's working.
      </p>
      <div class="hero-actions">
        <Button href="#audit">Score my site</Button>
        <Button href="#work" variant="outline" arrow={false}>See recent work</Button>
      </div>
      <p class="hero-note">Free Google PageSpeed scan. No email required.</p>
    </div>

    <div class="score-card" aria-hidden="true">
      <div class="score-card__chrome">
        <div class="score-card__dots">
          <span></span><span></span><span></span>
        </div>
        <span class="score-card__url">innatridgechristian.ca</span>
      </div>
      <div class="score-card__body">
        <div class="score-card__headline">
          <span class="score-card__num">97</span>
          <span class="score-card__label">Google<br/>performance</span>
        </div>
        <p class="score-card__note">Up from 54 on the old Squarespace site.</p>
        <div class="score-bars">
          <div class="score-bar"><span>Speed</span><div class="score-track"><span class="score-fill"></span></div><span class="score-val">97</span></div>
          <div class="score-bar"><span>Accessibility</span><div class="score-track"><span class="score-fill"></span></div><span class="score-val">100</span></div>
          <div class="score-bar"><span>SEO</span><div class="score-track"><span class="score-fill"></span></div><span class="score-val">100</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }

  .hero-blob { position: absolute; border-radius: 50%; z-index: 0; }
  .hero-blob--lg { right: -80px; top: -80px; width: 360px; height: 360px; background: var(--color-mint-100); }
  .hero-blob--sm { right: 60px; top: 140px; width: 120px; height: 120px; background: var(--color-peach); }

  .hero-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 60px; align-items: center;
  }

  .hero-title {
    font-size: clamp(38px, 6.2vw, 84px); font-weight: 800; line-height: 0.98;
    letter-spacing: -0.035em; margin: 0 0 22px 0; text-wrap: balance;
  }
  .hero-sub {
    font-size: clamp(16px, 1.35vw, 19px); color: var(--color-ink-500);
    line-height: 1.5; max-width: 56ch; margin: 0 0 28px 0; font-weight: 500;
  }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .hero-note { font-size: 13.5px; color: var(--color-ink-500); margin: 0 0 28px 0; font-style: italic; }

  .score-card {
    background: var(--color-ink); border-radius: 24px; padding: 22px;
    box-shadow: var(--shadow-card); transform: rotate(1.5deg); color: var(--color-paper);
  }
  .score-card__chrome { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .score-card__dots { display: flex; gap: 6px; }
  .score-card__dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.15); display: block; }
  .score-card__url { font-size: 11.5px; color: rgba(255,255,255,0.6); }

  .score-card__body { background: var(--color-mint-100); border-radius: 14px; padding: 22px; color: var(--color-ink); }
  .score-card__headline { display: flex; align-items: flex-end; gap: 10px; margin-bottom: 6px; }
  .score-card__num { font-size: 64px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: var(--color-mint-600); }
  .score-card__label { font-size: 12.5px; font-weight: 600; color: var(--color-ink-700); padding-bottom: 8px; }
  .score-card__note { font-size: 14px; color: var(--color-ink-700); font-weight: 500; margin: 0 0 16px 0; }

  .score-bars { display: grid; gap: 8px; }
  .score-bar { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 500; }
  .score-track { flex: 1; height: 6px; background: rgba(15,26,20,0.14); border-radius: 3px; overflow: hidden; margin: 0 12px; }
  .score-fill { display: block; height: 100%; background: var(--color-mint-500); border-radius: 3px; }
  /* Fixed bar widths (Speed 97, Accessibility 100, SEO 100) — data-driven values
     expressed as nth-child rules so no inline style is needed. */
  .score-bar:nth-child(1) .score-fill { width: 97%; }
  .score-bar:nth-child(2) .score-fill { width: 100%; }
  .score-bar:nth-child(3) .score-fill { width: 100%; }
  .score-val { color: var(--color-mint-600); font-weight: 700; }

  @media (max-width: 920px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-inner > * { min-width: 0; }
    .hero-blob { display: none; }
    .score-card { transform: none; max-width: 100%; padding: 16px; }
  }
</style>
