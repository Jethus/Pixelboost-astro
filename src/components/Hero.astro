---
import Button from "./ui/Button.astro";

interface Props {
  /** Hero heading. May contain HTML (e.g. a <span class="high">). Defaults to the home copy. */
  title?: string;
  /** Sub-headline paragraph. */
  sub?: string;
  /** Small italic note under the buttons. */
  note?: string;
  primaryLabel?: string;
  /** Where the primary CTA points when `scanInput` is false. */
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /**
   * Render the inline "enter your URL" mini-form as the primary CTA.
   * On submit the typed URL is handed to the Audit island, which
   * scrolls into view and starts the scan automatically.
   * Set false on pages without an Audit section; the primary CTA
   * becomes a plain button linking to `primaryHref`.
   */
  scanInput?: boolean;
}

const {
  title = `A website that proves it's <span class="high">working</span> for you.`,
  sub = "I build custom websites for small businesses in the GTA. Fast, accessible, and set up so you can actually see what's bringing customers in.",
  note = "Free site scan. No email required.",
  primaryLabel = "Score my site",
  primaryHref = "#audit",
  secondaryLabel = "See recent work",
  secondaryHref = "#work",
  scanInput = true,
} = Astro.props;
---

<section class="hero section-card surface-paper">
  <div aria-hidden="true" class="hero-blob hero-blob--lg"></div>
  <div aria-hidden="true" class="hero-blob hero-blob--sm"></div>

  <div class="hero-inner">
    <div>
      <h1 class="hero-title" set:html={title}></h1>
      <p class="hero-sub">{sub}</p>
      {scanInput ? (
        <form class="hero-scan-form" action="#audit">
          <label class="hero-scan-label" for="hero-scan-url">Your website URL</label>
          <input
            id="hero-scan-url"
            class="hero-scan-input"
            type="text"
            inputmode="url"
            autocomplete="url"
            placeholder="yourbusiness.ca"
          />
          <div class="hero-actions">
            <button
              type="submit"
              class="btn-mint btn-interactive hero-scan-btn plausible-event-name=Scan+Started plausible-event-location=hero"
            >
              {primaryLabel}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            <Button href={secondaryHref} variant="outline" arrow={false} class="plausible-event-name=See+Work+Clicked plausible-event-location=hero">{secondaryLabel}</Button>
          </div>
        </form>
      ) : (
        <div class="hero-actions">
          <Button href={primaryHref} class="plausible-event-name=Scan+Started plausible-event-location=hero">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="outline" arrow={false} class="plausible-event-name=See+Work+Clicked plausible-event-location=hero">{secondaryLabel}</Button>
        </div>
      )}
      <p class="hero-note">{note}</p>
    </div>

    <div class="score-card" aria-hidden="true">
      <div class="score-card__chrome">
        <div class="score-card__dots">
          <span></span><span></span><span></span>
        </div>
        <span class="score-card__url">example.ca</span>
      </div>
      <div class="score-card__body">
        <div class="score-card__headline">
          <span class="score-card__num">97</span>
          <span class="score-card__label">Google<br/>performance</span>
        </div>
        <p class="score-card__note">Up from 54 on the old Squarespace site.</p>
        <div class="score-bars">
          <div class="score-bar"><span>Speed</span><div class="score-track"><span class="score-fill"></span></div><span class="score-val">97</span></div>
          <div class="score-bar"><span>Accessibility</span><div class="score-track"><span class="score-fill"></span></div><span class="score-val">100</span></div>
          <div class="score-bar"><span>SEO</span><div class="score-track"><span class="score-fill"></span></div><span class="score-val">100</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }

  .hero-blob { position: absolute; border-radius: 50%; z-index: 0; }
  .hero-blob--lg { right: -80px; top: -80px; width: 360px; height: 360px; background: var(--color-mint-100); }
  .hero-blob--sm { right: 60px; top: 140px; width: 120px; height: 120px; background: var(--color-peach); }

  .hero-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 60px; align-items: center;
  }

  .hero-title {
    font-size: clamp(38px, 6.2vw, 84px); font-weight: 800; line-height: 0.98;
    letter-spacing: -0.035em; margin: 0 0 22px 0; text-wrap: balance;
  }
  .hero-sub {
    font-size: clamp(16px, 1.35vw, 19px); color: var(--color-ink-500);
    line-height: 1.5; max-width: 56ch; margin: 0 0 28px 0; font-weight: 500;
  }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; align-items: center; }
  .hero-note { font-size: 13.5px; color: var(--color-ink-500); margin: 0 0 28px 0; font-style: italic; }

  /* width: max-content sizes the form to its widest child (the buttons row),
     and stretch makes the input match it exactly. */
  .hero-scan-form {
    display: flex; flex-direction: column; gap: 12px;
    align-items: stretch; width: max-content; max-width: 100%;
  }
  .hero-scan-label {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .hero-scan-input {
    width: 100%; font-family: inherit; font-size: 15px;
    padding: 13px 20px; background: var(--color-paper);
    border: 1.5px solid var(--color-ink); border-radius: 9999px;
    outline: none; color: var(--color-ink);
  }
  .hero-scan-input::placeholder { color: var(--color-ink-400); }
  .hero-scan-input:focus { border-color: var(--color-mint-500); box-shadow: 0 0 0 4px var(--color-mint-100); }
  .hero-scan-btn { font-family: inherit; cursor: pointer; }

  .score-card {
    background: var(--color-ink); border-radius: 24px; padding: 22px;
    box-shadow: var(--shadow-card); transform: rotate(1.5deg); color: var(--color-paper);
  }
  .score-card__chrome { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .score-card__dots { display: flex; gap: 6px; }
  .score-card__dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.15); display: block; }
  .score-card__url { font-size: 11.5px; color: rgba(255,255,255,0.6); }

  .score-card__body { background: var(--color-mint-100); border-radius: 14px; padding: 22px; color: var(--color-ink); }
  .score-card__headline { display: flex; align-items: flex-end; gap: 10px; margin-bottom: 6px; }
  .score-card__num { font-size: 64px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: var(--color-mint-700); }
  .score-card__label { font-size: 12.5px; font-weight: 600; color: var(--color-ink-700); padding-bottom: 8px; }
  .score-card__note { font-size: 14px; color: var(--color-ink-700); font-weight: 500; margin: 0 0 16px 0; }

  .score-bars { display: grid; gap: 8px; }
  .score-bar { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 500; }
  .score-track { flex: 1; height: 6px; background: rgba(15,26,20,0.14); border-radius: 3px; overflow: hidden; margin: 0 12px; }
  .score-fill { display: block; height: 100%; background: var(--color-mint-500); border-radius: 3px; }
  /* Fixed bar widths (Speed 97, Accessibility 100, SEO 100) — data-driven values
     expressed as nth-child rules so no inline style is needed. */
  .score-bar:nth-child(1) .score-fill { width: 97%; }
  .score-bar:nth-child(2) .score-fill { width: 100%; }
  .score-bar:nth-child(3) .score-fill { width: 100%; }
  .score-val { color: var(--color-mint-700); font-weight: 700; }

  @media (max-width: 920px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-inner > * { min-width: 0; }
    .hero-blob { display: none; }
    .score-card { transform: none; max-width: 100%; padding: 16px; }
  }
</style>

<script>
  // Hand the typed URL to the Audit island, which prefills its input and
  // starts the scan. Dual channel because the island is client:visible: the
  // sessionStorage key covers "not hydrated yet" (its mount effect reads it
  // once the scroll brings it into view), the custom event covers "already
  // hydrated" (mount effect has run; only a live listener can update state).
  document.querySelectorAll<HTMLFormElement>(".hero-scan-form").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>(".hero-scan-input");
      const value = input?.value.trim() ?? "";
      if (value) {
        sessionStorage.setItem("pb_hero_url", value);
        window.dispatchEvent(new CustomEvent("pb:prefill-url", { detail: value }));
      }
      const target = document.getElementById("audit");
      if (!target) {
        // Page has no Audit section — the prefill is stored, so the audit
        // page's island picks it up on mount.
        window.location.href = "/free-website-audit";
        return;
      }
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
    });
  });
</script>
