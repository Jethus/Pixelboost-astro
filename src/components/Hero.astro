---
import Button from "./ui/Button.astro";
import { SCAN_STATS, SCAN_SAMPLE_SIZE } from "../consts";

interface Props {
  /** Hero heading. May contain HTML (e.g. a <span class="high">). Defaults to the home copy. */
  title?: string;
  /** Sub-headline paragraph. */
  sub?: string;
  /** Small italic note under the scan form / buttons. */
  note?: string;
  primaryLabel?: string;
  /** Where the primary CTA points when `scanInput` is false. */
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /**
   * Render the inline "enter your URL" mini-form as the primary CTA.
   * On submit the typed URL is handed to the Audit island, which
   * scrolls into view and starts the scan automatically.
   * Set false on pages without an Audit section; the primary CTA
   * becomes a plain button linking to `primaryHref`.
   */
  scanInput?: boolean;
}

const {
  title = `A website that proves it's working for you.`,
  sub = "I build custom websites for small businesses in the GTA. Fast, accessible, and set up so you can actually see what's bringing customers in.",
  note = "Free site scan. No email required.",
  primaryLabel = "Score my site",
  primaryHref = "#audit",
  secondaryLabel = "See recent work",
  secondaryHref = "#work",
  scanInput = true,
} = Astro.props;
---

<section class="hero section-card surface-paper">
  <h1 class="hero-title" set:html={title}></h1>
  <p class="hero-sub">{sub}</p>

  {scanInput ? (
    <>
      <form class="hero-scan-form" action="#audit">
        <label class="hero-scan-label" for="hero-scan-url">Your website URL</label>
        <input
          id="hero-scan-url"
          class="hero-scan-input"
          type="text"
          inputmode="url"
          autocomplete="url"
          placeholder="yourbusiness.ca"
        />
        <button
          type="submit"
          class="btn-mint btn-interactive hero-scan-btn plausible-event-name=Scan+Started plausible-event-location=hero"
        >
          {primaryLabel}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </form>
      <p class="hero-note">
        {note}
        <a href={secondaryHref} class="hero-worklink plausible-event-name=See+Work+Clicked plausible-event-location=hero">
          {secondaryLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </p>
    </>
  ) : (
    <>
      <div class="hero-actions">
        <Button href={primaryHref} class="plausible-event-name=Scan+Started plausible-event-location=hero">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="outline" arrow={false} class="plausible-event-name=See+Work+Clicked plausible-event-location=hero">{secondaryLabel}</Button>
      </div>
      <p class="hero-note">{note}</p>
    </>
  )}

  {scanInput && SCAN_STATS.length > 0 && (
    <div class="hero-scans">
      <span class="hero-scans-label">I scanned {SCAN_SAMPLE_SIZE} local business sites</span>
      <dl class="hero-stats" aria-label="What I found scanning local small-business websites">
        {SCAN_STATS.map((s) => (
          <div class="hero-stat">
            <dt class="hero-stat-value">{s.value}</dt>
            <dd class="hero-stat-label">{s.label}</dd>
          </div>
        ))}
      </dl>
      <p class="hero-scans-punch">
        That's the local baseline. Every site I build ships at <strong>95+</strong>.
      </p>
    </div>
  )}
</section>

<style>
  .hero-title {
    font-size: clamp(38px, 6.5vw, 88px); font-weight: 800; line-height: 0.98;
    letter-spacing: -0.035em; margin: 0 0 22px 0; text-wrap: balance;
    max-width: 17ch;
  }
  .hero-sub {
    font-size: clamp(16px, 1.35vw, 19px); color: var(--color-ink-500);
    line-height: 1.5; max-width: 56ch; margin: 0 0 30px 0; font-weight: 500;
  }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; align-items: center; }
  .hero-note {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px;
    font-size: 13.5px; color: var(--color-ink-500); margin: 16px 0 0 0; font-style: italic;
  }
  .hero-worklink {
    display: inline-flex; align-items: center; gap: 6px;
    font-style: normal; font-weight: 600; font-size: 14px; color: var(--color-ink);
    text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px;
  }
  .hero-worklink:hover { color: var(--color-mint-700); }
  .hero-worklink svg { flex: none; }

  .hero-scan-form {
    display: flex; flex-wrap: wrap; gap: 12px;
    align-items: stretch; max-width: 620px;
  }
  .hero-scan-label {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .hero-scan-input {
    flex: 1 1 300px; min-width: 0; font-family: inherit; font-size: 16px;
    padding: 15px 24px; background: var(--color-paper);
    border: 1.5px solid var(--color-ink); border-radius: 9999px;
    outline: none; color: var(--color-ink);
  }
  .hero-scan-input::placeholder { color: var(--color-ink-400); }
  .hero-scan-input:focus { border-color: var(--color-mint-500); box-shadow: 0 0 0 4px var(--color-mint-100); }
  .hero-scan-btn { font-family: inherit; cursor: pointer; flex: none; justify-content: center; }
  @media (max-width: 480px) {
    .hero-scan-btn { flex: 1 1 100%; }
  }

  /* Local-scan stat strip — real aggregate figures as the backdrop to "I ship
     95+". Editorial hairline footer of the hero. */
  .hero-scans {
    margin-top: clamp(40px, 6vw, 68px);
    border-top: 1px solid var(--color-line-2);
    padding-top: 22px;
  }
  .hero-scans-label {
    display: block; margin-bottom: 16px;
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-ink-500);
  }
  .hero-stats {
    margin: 0 0 16px; padding: 0;
    display: flex; flex-wrap: wrap; gap: 14px 40px;
  }
  .hero-stat { margin: 0; }
  .hero-stat-value {
    font-size: clamp(26px, 3vw, 36px); font-weight: 800;
    letter-spacing: -0.02em; line-height: 1; color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .hero-stat-label {
    margin: 5px 0 0; font-size: 13px; line-height: 1.35;
    color: var(--color-ink-500); font-weight: 500; max-width: 20ch;
  }
  .hero-scans-punch {
    margin: 0; font-size: 14px; color: var(--color-ink-700);
    font-weight: 500; line-height: 1.5;
  }
  .hero-scans-punch strong { color: var(--color-mint-700); font-weight: 800; }
</style>

<script>
  // Hand the typed URL to the Audit island, which prefills its input and
  // starts the scan. Dual channel because the island is client:visible: the
  // sessionStorage key covers "not hydrated yet" (its mount effect reads it
  // once the scroll brings it into view), the custom event covers "already
  // hydrated" (mount effect has run; only a live listener can update state).
  document.querySelectorAll<HTMLFormElement>(".hero-scan-form").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>(".hero-scan-input");
      const value = input?.value.trim() ?? "";
      if (value) {
        sessionStorage.setItem("pb_hero_url", value);
        window.dispatchEvent(new CustomEvent("pb:prefill-url", { detail: value }));
      }
      const target = document.getElementById("audit");
      if (!target) {
        // Page has no Audit section — the prefill is stored, so the audit
        // page's island picks it up on mount.
        window.location.href = "/free-website-audit";
        return;
      }
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
    });
  });
</script>
