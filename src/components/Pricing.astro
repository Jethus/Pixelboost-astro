---
import SectionHeader from "./ui/SectionHeader.astro";
const plans = [
  {
    variant: "monthly",
    title: "Monthly",
    price: "$200",
    priceNote: "/ month",
    features: [
      { text: "Design and development", included: true },
      { text: "Plausible analytics included", included: true },
      { text: "Hosting included", included: true },
      { text: "+$100 per page after 5", included: true },
      { text: "+$250 to add a blog", included: true },
      { text: "24/7 support", included: true },
      { text: "Lifetime updates", included: true },
    ],
  },
  {
    variant: "lump",
    title: "One-off",
    price: "$3,200",
    priceNote: "flat",
    features: [
      { text: "Design and development", included: true },
      { text: "Plausible analytics included", included: true },
      { text: "+$25/mo hosting", included: true },
      { text: "+$50/mo unlimited edits add-on", included: true },
      { text: "+$100 per page after 5", included: true },
      { text: "+$250 to add a blog", included: true },
      { text: "24/7 support", included: false },
      { text: "Lifetime updates", included: false },
    ],
  },
];

const featured = plans.find(p => p.variant === 'monthly')!;
const standard = plans.find(p => p.variant === 'lump')!;
---

<section id="pricing" class="section-card surface-paper">
  <SectionHeader eyebrow="Honest pricing" subhead="Monthly if you want ongoing help. Flat rate if you want the site handed over. Same build quality either way.">
    Two ways to work together. <span class="high">No surprise invoices.</span>
  </SectionHeader>

  <div class="price-grid">
    <div class="price-card featured">
      <!-- <span class="badge">Most chosen</span> -->
      <h3 class="plan-name">{featured.title}</h3>
      <ul class="plan-features">
        {featured.features.map(f => (
          <li class:list={["feat-row", { "is-off": !f.included }]}>
            <span class="feat-text">{f.text}</span>
            {f.included
              ? <svg class="feat-icon feat-yes" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              : <svg class="feat-icon feat-no" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>}
          </li>
        ))}
      </ul>
      <div class="plan-price">{featured.price}<small>{featured.priceNote}</small></div>
      <a href="/contact" class="btn-mint btn-block btn-on-dark btn-interactive plan-btn">Get started <svg class="plan-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    </div>

    <div class="price-card">
      <h3 class="plan-name">{standard.title}</h3>
      <ul class="plan-features">
        {standard.features.map(f => (
          <li class:list={["feat-row", { "is-off": !f.included }]}>
            <span class="feat-text">{f.text}</span>
            {f.included
              ? <svg class="feat-icon feat-yes" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              : <svg class="feat-icon feat-no" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>}
          </li>
        ))}
      </ul>
      <div class="plan-price">{standard.price}<small>{standard.priceNote}</small></div>
      <a href="/contact" class="btn-ink btn-block btn-interactive plan-btn">Get started <svg class="plan-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    </div>
  </div>

  <div class="price-foot">
    <strong>Fair and simple.</strong> The monthly plan runs for the first year, then it's month-to-month. Cancel anytime after the first year and the site is yours. With the flat rate, the code, content, and domain are yours from day one.
  </div>
</section>

<style>
  .price-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 16px;
    margin-top: 36px;
    align-items: stretch;
  }
  @media (max-width: 820px) { .price-grid { grid-template-columns: 1fr; } }

  .price-card {
    background: var(--color-paper-2);
    border-radius: 24px;
    padding: 32px;
    border: 1px solid var(--color-line);
    display: flex; flex-direction: column; gap: 16px;
  }
  .price-card.featured {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  .badge {
    align-self: flex-start;
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 5px 10px; border-radius: 9999px;
    background: var(--color-mint-500); color: var(--color-ink);
  }

  .plan-name  {
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin: 0;
  }

  .plan-price {
    font-size: 48px; font-weight: 800; letter-spacing: -0.035em; line-height: 1; margin: 6px 0;
  }
  .plan-price small {
    font-size: 14px; font-weight: 500; letter-spacing: -0.04em; color: var(--color-ink-500);
  }
  .featured .plan-price small { color: rgba(248,245,238,0.55); }

  .plan-features {
    margin: 8px 0 0 0; padding: 0; list-style: none; display: grid; gap: 10px;
  }

  /* Feature row: text left, icon pushed to the right edge */
  .feat-row {
    display: flex; align-items: center; gap: 12px;
    font-size: 14.5px; color: var(--color-ink-700); line-height: 1.4;
  }
  .feat-text { flex: 1; }
  .featured .feat-row { color: rgba(248,245,238,0.85); }

  .feat-icon { flex: none; }
  .feat-yes { color: var(--color-mint-600); }
  .featured .feat-yes { color: var(--color-mint-300); }
  .feat-no  { color: var(--color-ink-400); }
  .featured .feat-no { color: rgba(248,245,238,0.4); }

  /* Not-included rows read muted */
  .feat-row.is-off .feat-text { color: var(--color-ink-400); }
  .featured .feat-row.is-off .feat-text { color: rgba(248,245,238,0.45); }

  .plan-btn { padding: 13px 20px; font-size: 14.5px; }
  .plan-btn-arrow { flex: none; }

  .price-foot {
    margin-top: 28px;
    padding: 20px 24px;
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    border-radius: 16px;
    font-size: 14.5px; line-height: 1.55; color: var(--color-ink-700);
    max-width: 780px;
  }
  .price-foot strong { color: var(--color-ink); font-weight: 700; }
</style>
