---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SectionHeader from "./ui/SectionHeader.astro";

const clientsDocs = (await getCollection("portfolio")).sort(
  (a, b) => a.data.order - b.data.order,
);

const trendingUp = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`;
---

<section id="work" class="section-card surface-mint">
  <div data-reveal>
    <SectionHeader eyebrow="Results" eyebrowOnMint={true} subhead="Every rebuild starts with a scorecard. Here's what before and after looks like.">
      Real projects. Before and after.
    </SectionHeader>
  </div>

  <div class="work-grid">
    {clientsDocs.map((client, i) => (
      <div class="work-card" data-reveal>
        {client.data.url ? (
          <a href={client.data.url} target="_blank" rel="noopener noreferrer" class="vis-block" aria-label={`Visit ${client.data.title}`}>
            <Image src={client.data.image} alt={client.data.imageMobile ? `${client.data.title} desktop` : client.data.title} class="vis-img" width={600} height={338} />
            {client.data.imageMobile && (
              <span class="vis-phone">
                <Image src={client.data.imageMobile} alt={`${client.data.title} mobile`} class="vis-phone-img" width={240} height={522} />
              </span>
            )}
            <span class="vis-tag">{client.data.tags}</span>
            <span class="vis-ext-icon" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg></span>
          </a>
        ) : (
          <div class="vis-block">
            <Image src={client.data.image} alt={client.data.imageMobile ? `${client.data.title} desktop` : client.data.title} class="vis-img" width={600} height={338} />
            {client.data.imageMobile && (
              <span class="vis-phone">
                <Image src={client.data.imageMobile} alt={`${client.data.title} mobile`} class="vis-phone-img" width={240} height={522} />
              </span>
            )}
            <span class="vis-tag">{client.data.tags}</span>
          </div>
        )}

        <div class="card-content">
          <div>
            <h3 class="card-title">{client.data.title}</h3>
            {client.data.location && (
              <span class="card-location">{client.data.location}</span>
            )}
          </div>
          {client.data.summary && (
            <p class="card-body">{client.data.summary}</p>
          )}

          {client.data.stats && client.data.stats.length > 0 && (
            <div class="ba-table">
              {client.data.stats.map(stat => (
                <div class="ba-row">
                  <span class="ba-label">{stat.label}</span>
                  <span class="ba-before">{stat.before}</span>
                  <svg class="ba-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  <span class="ba-after" data-countup>{stat.after}</span>
                </div>
              ))}
            </div>
          )}

          {client.data.kpi && (
            <div class="kpi-badge">
              <span set:html={trendingUp} class="kpi-icon" />
              {client.data.kpi}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    /* minmax(0, 1fr) — not bare 1fr — so tracks can shrink below their
       content's min-content width. Without this the card overflows its
       cell on narrow phones and hugs the right edge (looks off-centre). */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 36px;
  }
  @media (max-width: 920px) { .work-grid { grid-template-columns: minmax(0, 1fr); } }

  .work-card {
    background: var(--color-paper);
    border-radius: var(--radius-card);
    padding: 24px;
    border: 1px solid var(--color-line);
    display: flex; flex-direction: column; gap: 14px;
    min-width: 0;
  }

  .vis-block {
    border-radius: 12px; background: var(--color-paper);
    position: relative; overflow: hidden;
    aspect-ratio: 16/9;
    display: block;
  }

  /* Desktop screenshot is 16:9 — box matches, so it shows end-to-end, no crop */
  .vis-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: top center;
    display: block;
    border-radius: 12px;
  }

  /* Phone overlay — mobile screenshot floating bottom-right */
  .vis-phone {
    position: absolute;
    right: 14px;
    bottom: -8px;
    width: 26%;
    aspect-ratio: 9/16;
    z-index: 3;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-paper);
    border: 3px solid var(--color-paper);
    box-shadow: 0 10px 28px rgba(15,26,20,0.28),
                0 2px 6px rgba(15,26,20,0.18);
  }

  .vis-phone-img {
    display: block;
    width: 100%; height: 100%;
    object-fit: cover; object-position: top center;
    border-radius: 11px;
  }

  .vis-block::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(15,26,20,0.55) 0%, transparent 50%);
    border-radius: 12px;
  }

  .vis-tag {
    position: absolute; left: 14px; bottom: 12px; z-index: 2;
    color: #ffffff; font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }

  .vis-ext-icon {
    position: absolute; right: 12px; top: 12px; z-index: 2;
    width: 28px; height: 28px; border-radius: 50%;
    background: rgba(255,255,255,0.15); backdrop-filter: blur(4px);
    color: #fff; font-size: 13px;
    display: grid; place-items: center;
    opacity: 0; transition: opacity 0.2s;
  }

  a.vis-block:hover .vis-ext-icon { opacity: 1; }
  a.vis-block { text-decoration: none; }

  .ba-table {
    display: grid; gap: 6px;
    padding-top: 14px; margin-top: auto;
    border-top: 1px dashed var(--color-line-2);
  }
  .ba-row {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 10px; align-items: baseline;
    font-size: 13px;
  }
  .ba-label  { font-size: 11px; font-weight: 600; color: var(--color-ink-500); text-transform: uppercase; letter-spacing: 0.06em; }
  .ba-before { color: var(--color-red);    font-weight: 700; font-variant-numeric: tabular-nums; }
  .ba-arrow  { color: var(--color-ink-400); flex: none; align-self: center; }
  .ba-after  { color: var(--color-mint-700); font-weight: 700; font-variant-numeric: tabular-nums; }

  .kpi-badge {
    display: flex; align-items: center; gap: 8px;
    margin-top: 4px;
    padding: 10px 12px;
    background: var(--color-mint-50);
    border-radius: 10px;
    font-size: 13px; font-weight: 600;
    color: var(--color-ink);
    border: 1px solid var(--color-mint-200);
  }

  .kpi-icon {
    flex-shrink: 0;
    color: var(--color-mint-700);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card-title {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 2px 0;
  }

  .card-location {
    font-size: 13px;
    color: var(--color-ink-500);
  }

  .work-card:nth-child(1) { --reveal-i: 1; }
  .work-card:nth-child(2) { --reveal-i: 2; }
  .work-card:nth-child(3) { --reveal-i: 3; }
  .work-card:nth-child(4) { --reveal-i: 4; }
</style>

<script>
  // Count-up on the "after" stat once its card scrolls in. Only numeric
  // values tween; text like "WCAG AA" is left as-is. Off for reduced-motion.
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReduced && "IntersectionObserver" in window) {
    const animate = (el: HTMLElement) => {
      const raw = (el.textContent || "").trim();
      // Split into number + suffix, e.g. "0.9s" -> 0.9 + "s", "94" -> 94 + "".
      const match = raw.match(/^(-?\d+(?:\.\d+)?)(.*)$/);
      if (!match) return; // non-numeric — leave untouched

      const target = parseFloat(match[1]);
      const suffix = match[2];
      const decimals = (match[1].split(".")[1] || "").length;
      const duration = 900;
      const start = performance.now();

      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        // easeOutCubic
        const eased = 1 - Math.pow(1 - t, 3);
        const val = (target * eased).toFixed(decimals);
        el.textContent = val + suffix;
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = match[1] + suffix; // exact final
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 },
    );

    document
      .querySelectorAll<HTMLElement>(".work-card [data-countup]")
      .forEach((el) => io.observe(el));
  }
</script>
