---
import Button from "./ui/Button.astro";
---

<section id="cta" class="section-card" style="background: linear-gradient(135deg, var(--color-ink) 0%, #14261d 100%); color: var(--color-paper); text-align: center;">
  <h2 style="color: var(--color-paper); margin: 0 0 16px 0;">Find out what your site is costing you.</h2>
  <p class="section-subhead" style="color: rgba(248,245,238,0.7); margin: 0 auto 32px;">
    Run a free Google PageSpeed scan. No email required. You'll see what is slowing people down, what is missing, and what I would fix first.
  </p>
  <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
    <Button href="#audit" variant="mint">Score my site</Button>
    <Button href="mailto:hello@pixelboost.ca" variant="outline-light" arrow={false}>Or just email me</Button>
  </div>
</section>
