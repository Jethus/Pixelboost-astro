---
import Button from "./ui/Button.astro";

interface Props {
  /** Where "Score my site" points. Pages that carry their own Audit island
   *  pass "#audit" so the button stays on-page instead of going home. */
  scanHref?: string;
}
const { scanHref = "/#audit" }: Props = Astro.props;
---

<section id="cta" class="section-card cta-section">
  <h2 class="cta-heading">Find out what your site is costing you.</h2>
  <p class="section-subhead cta-subhead">
    Run a free scan of your site. No email required. You'll see what's slowing people down, what's missing, and what I'd fix first.
  </p>
  <div class="cta-actions">
    <Button href={scanHref} variant="mint" class="btn-on-dark">Score my site</Button>
    <Button href="mailto:josh@pixelboost.ca" variant="outline-light" arrow={false}>Or just email me</Button>
  </div>
</section>

<style>
  .cta-section {
    background: linear-gradient(135deg, var(--color-ink) 0%, #14261d 100%);
    color: var(--color-paper);
  }

  .cta-heading {
    color: var(--color-paper);
    margin: 0 0 16px 0;
  }

  .cta-subhead {
    color: rgba(248, 245, 238, 0.7);
    margin: 0 0 32px;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
