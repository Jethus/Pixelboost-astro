---
// Reusable prose table. Styling lives in global.css under `.prose-table`,
// shared with markdown tables in blog posts (.post-body table) so both
// look identical — mint header + alternating row shades.
//
// Two ways to use it:
//   <Table headers={["A","B"]} rows={[["1","2"],["3","4"]]} />
// or hand-author the markup in a slot:
//   <Table><thead>…</thead><tbody>…</tbody></Table>
interface Props {
  headers?: string[];
  rows?: string[][];
}
const { headers, rows } = Astro.props;
const hasData = headers && rows;
---

<table class="prose-table">
  {hasData ? (
    <>
      <thead>
        <tr>{headers.map((h) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>{row.map((cell) => <td set:html={cell} />)}</tr>
        ))}
      </tbody>
    </>
  ) : (
    <slot />
  )}
</table>
