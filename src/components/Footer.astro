---
import logoBlack from "../assets/svgs/logo-black.svg";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="foot-grid">
    <div>
      <a href="/" class="foot-logo">
        <img src={logoBlack.src} alt="Pixelboost" width="1048" height="226" loading="lazy" />
      </a>
      <p class="foot-blurb">
        A one-person web studio in Ontario, building fast, accessible custom websites for Canadian small businesses.
      </p>
    </div>

    <div>
      <h2 class="foot-head">Pixelboost</h2>
      <a href="/about"   class="foot-link">About</a>
      <a href="/blog"    class="foot-link">Blog</a>
      <a href="/contact" class="foot-link">Contact</a>
      <a href="/free-website-audit" class="foot-link">Free Website Audit</a>
      <a href="/durham-region-web-design" class="foot-link">Durham Region</a>
      <a href="/privacy" class="foot-link">Privacy</a>
    </div>

    <div>
      <h2 class="foot-head">Get in touch</h2>
      <a href="mailto:josh@pixelboost.ca" class="foot-link">josh@pixelboost.ca</a>
      <a href="tel:+19057812464"           class="foot-link">(905) 781-2464</a>
    </div>
  </div>

  <div class="foot-bottom">
    <span>&copy; {year} Pixelboost · Made in Toronto, Ontario</span>
    <span>Built on this site. Lighthouse 100/100/100/100.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-paper);
    max-width: 1200px; margin: 24px auto 0;
    border-radius: 28px 28px 0 0;
    padding: 40px clamp(28px, 5vw, 72px) 0;
    font-size: 14px; color: var(--color-ink-500);
  }

  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; }
  @media (max-width: 720px) { .foot-grid { grid-template-columns: 1fr; } }

  .foot-logo { display: inline-flex; line-height: 0; }
  .foot-logo img { height: 40px; width: auto; display: block; }

  .foot-blurb { margin: 14px 0 0 0; max-width: 40ch; line-height: 1.5; font-size: 14px; color: var(--color-ink-500); }

  .foot-head { margin: 0 0 12px 0; font-size: 13px; font-weight: 700; color: var(--color-ink); letter-spacing: -0.01em; }

  .foot-link { display: block; color: var(--color-ink-500); text-decoration: none; padding: 4px 0; transition: color 0.15s; }
  .foot-link:hover { color: var(--color-mint-600); }

  .foot-bottom {
    margin-top: 32px; padding: 16px 0 32px;
    border-top: 1px solid var(--color-line);
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    font-size: 12px; color: var(--color-ink-500);
  }
</style>
