---
import SectionHeader from "./ui/SectionHeader.astro";

interface Card { title: string; body: string; }
interface Props {
  eyebrow?: string;
  subhead?: string;
  heading?: string;
  /** Checklist rows. Defaults to the home copy. */
  cards?: Card[];
}

const {
  eyebrow = "Why it matters",
  subhead = "Most owners can't see it. Customers feel it every day.",
  heading = "Your current site might be quietly costing you customers.",
  cards = [
    {
      title: "Small changes cost you time and money.",
      body: "New hours? A new service? A photo swap? That should be one quick email, not a week of waiting and an invoice.",
    },
    {
      title: "You can't see how your customers arrive.",
      body: "Without any tracking, you're guessing which calls come from your site and which come from word of mouth.",
    },
    {
      title: "Your site is too slow.",
      body: "A slow page costs you the customer before they've even read a word. Most sites built on Wix or Squarespace score under 50 on mobile.",
    },
    {
      title: "It doesn't look right on phones.",
      body: "Most customers are browsing on their phone. If your site squishes, overflows, or is hard to tap, they move on, and you never know why.",
    },
  ],
}: Props = Astro.props;
---

<section id="problem" class="problem-check section-card surface-paper-2">
  <div data-reveal>
    <SectionHeader eyebrow={eyebrow} subhead={subhead}>
      {heading}
    </SectionHeader>
  </div>

  <div class="check-list" role="group" aria-labelledby="problem-check-legend">
    <p class="check-legend" id="problem-check-legend">Tick anything that sounds familiar</p>
    {cards.map((card) => (
      <label class="check-row" data-reveal>
        <input type="checkbox" class="check-box" />
        <span class="check-text">
          <span class="check-title">{card.title}</span>
          <span class="check-body">{card.body}</span>
        </span>
      </label>
    ))}

    <div class="check-result">
      <p class="check-msg" data-check-msg aria-live="polite"></p>
      <a
        href="#audit"
        class="btn-mint btn-interactive check-cta plausible-event-name=Scan+Started plausible-event-location=checklist"
        data-check-cta
        hidden
      >
        Score my site
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <p class="check-nojs">
        Sound familiar? The <a class="prose-link" href="/free-website-audit">free scan</a> shows what it's costing you. Thirty seconds, no email.
      </p>
    </div>
  </div>
</section>

<style>
  .check-list {
    margin-top: 40px;
    max-width: 840px;
  }

  .check-legend {
    margin: 0 0 6px 0;
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-ink-500);
  }

  .check-row {
    display: flex; align-items: flex-start; gap: 18px;
    padding: 22px 6px;
    border-bottom: 1px solid var(--color-line-2);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .check-row:hover { background: rgba(248, 245, 238, 0.55); }

  .check-row:nth-of-type(1) { --reveal-i: 1; }
  .check-row:nth-of-type(2) { --reveal-i: 2; }
  .check-row:nth-of-type(3) { --reveal-i: 3; }
  .check-row:nth-of-type(4) { --reveal-i: 4; }

  .check-box {
    appearance: none; -webkit-appearance: none;
    width: 24px; height: 24px; margin: 2px 0 0 0;
    border: 1.5px solid var(--color-ink); border-radius: 7px;
    background: var(--color-paper);
    flex: none; cursor: pointer;
    display: grid; place-items: center;
    transition: background 0.15s ease;
  }
  .check-box::after {
    content: "";
    width: 12px; height: 7px; margin-top: -3px;
    border-left: 2.5px solid var(--color-mint-500);
    border-bottom: 2.5px solid var(--color-mint-500);
    transform: rotate(-45deg) scale(0);
    transition: transform 0.15s ease;
  }
  .check-box:checked { background: var(--color-ink); }
  .check-box:checked::after { transform: rotate(-45deg) scale(1); }
  .check-box:focus-visible {
    outline: none;
    border-color: var(--color-mint-500);
    box-shadow: 0 0 0 4px var(--color-mint-100);
  }

  .check-text { min-width: 0; }
  .check-title {
    display: block;
    font-size: clamp(17px, 1.4vw, 20px); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.25; color: var(--color-ink);
  }
  .check-body {
    display: block; margin-top: 4px;
    font-size: clamp(14.5px, 1.1vw, 16px); color: var(--color-ink-500);
    line-height: 1.55; font-weight: 450;
  }

  .check-result {
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px;
    padding-top: 22px;
    min-height: 32px;
  }
  .check-msg {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 17px); font-weight: 600;
    color: var(--color-ink-700); line-height: 1.5;
    max-width: 46ch;
  }
  .check-cta { flex: none; }

  /* Without JS the tally never runs — show a static line instead. */
  .check-nojs {
    display: none;
    margin: 0;
    font-size: clamp(15px, 1.2vw, 17px); font-weight: 500;
    color: var(--color-ink-700); line-height: 1.5;
  }
  :global(.no-js) .check-nojs { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .check-box, .check-box::after, .check-row { transition: none; }
  }

  @media (max-width: 640px) {
    .check-list { margin-top: 32px; }
    .check-row { gap: 14px; padding: 18px 2px; }
  }
</style>

<script>
  // Self-diagnosis tally: count checked rows, speak to the result line, and
  // reveal the scan CTA once anything is ticked. The CTA points at the
  // on-page Audit island when it exists, the audit page otherwise.
  const WORDS = ["none", "one", "two", "three", "four", "five", "six"];

  document.querySelectorAll<HTMLElement>(".problem-check").forEach((section) => {
    const boxes = Array.from(section.querySelectorAll<HTMLInputElement>(".check-box"));
    const msg = section.querySelector<HTMLElement>("[data-check-msg]");
    const cta = section.querySelector<HTMLAnchorElement>("[data-check-cta]");
    if (!msg || !cta || boxes.length === 0) return;

    if (!document.getElementById("audit")) cta.href = "/free-website-audit";

    const line = (n: number, total: number): string => {
      const word = (x: number) => WORDS[x] ?? String(x);
      if (n === 0) return "None of them? You're in better shape than most sites I scan.";
      if (n === total) return `All ${word(total)}. The good news: every one of these is fixable. Start with the scan — it takes about 30 seconds.`;
      if (n === 1) return `One of ${word(total)} is still costing you. The free scan shows how much.`;
      return `${word(n)[0].toUpperCase()}${word(n).slice(1)} of ${word(total)}. Worth finding out what they're costing you — the scan takes about 30 seconds.`;
    };

    const update = () => {
      const n = boxes.filter((b) => b.checked).length;
      msg.textContent = line(n, boxes.length);
      cta.hidden = n === 0;
    };

    boxes.forEach((box) => box.addEventListener("change", update));
  });
</script>
