---
import SectionHeader from "./ui/SectionHeader.astro";

interface Card { title: string; body: string; }
interface Props {
  eyebrow?: string;
  subhead?: string;
  heading?: string;
  /** Up to 4 cards; icons are reused by position. Defaults to the home copy. */
  cards?: Card[];
}

const {
  eyebrow = "Why it matters",
  subhead = "Most owners can't see it. Customers feel it every day.",
  heading = "Your current site might be quietly costing you customers.",
  cards = [
    {
      title: "Small changes cost you time and money.",
      body: "New hours? A new service? A photo swap? That should be one quick email, not a week of waiting and an invoice.",
    },
    {
      title: "You can't see how your customers arrive.",
      body: "Without any tracking, you're guessing which calls come from your site and which come from word of mouth.",
    },
    {
      title: "Your site is too slow.",
      body: "A slow page costs you the customer before they've even read a word. Most sites built on Wix or Squarespace score under 50 on mobile.",
    },
    {
      title: "It doesn't look right on phones.",
      body: "Most customers are browsing on their phone. If your site squishes, overflows, or is hard to tap, they move on, and you never know why.",
    },
  ],
}: Props = Astro.props;

const icons = [
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
];
---

<section id="problem" class="section-card surface-paper-2">
  <div data-reveal>
    <SectionHeader eyebrow={eyebrow} subhead={subhead}>
      {heading}
    </SectionHeader>
  </div>

  <ul class="problem-list" aria-label="Common website problems">
    {cards.map((card, i) => (
      <li class="problem-item" data-reveal>
        <span class="icon-tile" aria-hidden="true" set:html={icons[i]} />
        <h3 class="problem-title">{card.title}</h3>
        <p class="problem-body">{card.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .problem-list {
    margin-top: 40px;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .problem-item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 6px;
    align-items: start;
    padding: 22px;
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: rgba(248, 245, 238, 0.48);
  }

  .problem-title {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    font-size: clamp(18px, 1.45vw, 22px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .problem-body {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    font-size: clamp(14.5px, 1.1vw, 16.5px);
    color: var(--color-ink-500);
    line-height: 1.55;
    font-weight: 450;
  }

  .icon-tile {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 40px; height: 40px; border-radius: var(--radius-icon);
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    color: var(--color-mint-700);
    display: grid; place-items: center;
    flex-shrink: 0;
  }

  .problem-item:nth-child(1) { --reveal-i: 1; }
  .problem-item:nth-child(2) { --reveal-i: 2; }
  .problem-item:nth-child(3) { --reveal-i: 3; }
  .problem-item:nth-child(4) { --reveal-i: 4; }

  @media (max-width: 640px) {
    .problem-list {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }

    /* Icon on its own row so the title and body span the full card width
       instead of wrapping in a cramped column beside the icon. */
    .problem-item {
      grid-template-columns: 1fr;
      row-gap: 12px;
      padding: 20px;
    }

    .icon-tile {
      grid-column: 1;
      grid-row: 1;
    }

    .problem-title { grid-column: 1; grid-row: 2; }
    .problem-body  { grid-column: 1; grid-row: 3; }
  }
</style>
