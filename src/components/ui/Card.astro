---
/**
 * Card — base soft surface card. Single source for paper/mint cards
 * with consistent border, radius, padding, and hover lift.
 *
 * Renders as <a> when `href` is set, else <div>.
 *
 * Usage:
 *   <Card>...</Card>
 *   <Card variant="mint">...</Card>
 *   <Card href="/blog/x">...</Card>
 */
interface Props {
  variant?: "default" | "mint";
  href?: string;
  class?: string;
  padding?: string;
}
const { variant = "default", href, class: className = "", padding } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={["card", `card--${variant}`, href && "card--link", className]}
  style={padding ? `padding: ${padding};` : undefined}
>
  <slot />
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    padding: 24px;
    box-sizing: border-box;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      transform 0.2s cubic-bezier(0.2, 0.9, 0.2, 1),
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .card--default {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }

  .card--mint {
    background: var(--color-mint-50);
    border: 1px solid var(--color-mint-200);
  }

  .card--link:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 44px -24px rgba(15, 26, 20, 0.4);
    border-color: var(--color-line-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card--link:hover { transform: none; transition: none; }
  }
</style>
