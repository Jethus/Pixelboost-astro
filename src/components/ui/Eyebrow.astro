---
/**
 * Eyebrow — mint pill label above section headings.
 * onMint: use a paper background instead of the default mint-100,
 *         for placement on mint-tinted sections (e.g. Portfolio).
 */
interface Props {
  label: string;
  onMint?: boolean;
  class?: string;
}
const { label, onMint = false, class: className = "" } = Astro.props;
---

<span class:list={["eyebrow-chip", onMint && "eyebrow-chip--on-mint", className]}>
  <span class="eyebrow-dot" aria-hidden="true"></span>{label}
</span>

<style>
  .eyebrow-chip--on-mint { background: var(--color-paper); }
</style>
