---
/**
 * FeaturedBlogCard — the big "Latest" post card. Used by the blog index
 * and the landing-page BlogTeaser so the two stay identical.
 */
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  readTime: number;
  slug: string;
}
const { title, description, pubDate, updatedDate, readTime, slug } = Astro.props;
const displayDate = updatedDate ?? pubDate;
// Dates are authored as bare YYYY-MM-DD (parsed as UTC midnight); format in UTC
// so the build machine's local timezone can't shift the shown day back by one.
const formattedDate = displayDate.toLocaleDateString("en-CA", {
  year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
});
const datePrefix = updatedDate ? "Updated " : "";
---

<a href={`/blog/${slug}`} class="featured-card" data-reveal>
  <span class="featured-metarow">
    <span class="featured-flag">Latest</span>
    <span class="featured-meta">{datePrefix}{formattedDate} · {readTime} min read</span>
  </span>
  <h2 class="featured-title">{title}</h2>
  <p class="featured-desc">{description}</p>
  <span class="featured-readmore">
    Read post
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </span>
</a>

<style>
  .featured-card {
    display: block;
    position: relative;
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-200);
    border-radius: var(--radius-card);
    padding: clamp(28px, 4vw, 48px);
    margin-bottom: 16px;
    text-decoration: none;
    color: var(--color-ink);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.9, 0.2, 1),
      box-shadow 0.2s ease;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 54px -28px rgba(15, 26, 20, 0.45);
  }

  .featured-metarow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .featured-flag {
    display: inline-block;
    background: var(--color-mint-500);
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    border-radius: 9999px;
  }

  .featured-meta {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mint-700);
  }

  .featured-title {
    font-size: clamp(26px, 2.8vw, 36px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 18px 0;
    max-width: 22ch;
    transition: color 0.2s ease;
  }

  .featured-card:hover .featured-title { color: var(--color-mint-700); }

  .featured-desc {
    font-size: clamp(15px, 1.3vw, 18px);
    color: var(--color-ink-500);
    line-height: 1.55;
    max-width: 58ch;
    margin: 0 0 24px 0;
    font-weight: 500;
  }

  .featured-readmore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .featured-readmore svg {
    transition: transform 0.2s cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .featured-card:hover .featured-readmore svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .featured-card,
    .featured-card:hover,
    .featured-readmore svg,
    .featured-card:hover .featured-readmore svg {
      transform: none;
      transition: none;
    }
  }
</style>
