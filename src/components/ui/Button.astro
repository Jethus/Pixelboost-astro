---
/**
 * Button — site CTA/link button. Maps to the btn-* @utility classes.
 *
 * Usage:
 *   <Button href="#audit">Score my site</Button>             // mint + arrow
 *   <Button href="#work" variant="outline" arrow={false}>See recent work</Button>
 *   <Button href="/contact" variant="outline-light">Get in touch</Button>
 */
interface Props {
  href: string;
  variant?: "mint" | "outline" | "outline-light";
  arrow?: boolean;
  class?: string;
}
const { href, variant = "mint", arrow = true, class: className = "" } = Astro.props;
const variantClass = {
  mint: "btn-mint",
  outline: "btn-outline",
  "outline-light": "btn-outline-light",
}[variant];
---

<a href={href} class:list={[variantClass, "btn-interactive", className]}>
  <slot />
  {arrow && (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  )}
</a>
