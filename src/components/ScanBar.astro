---
/**
 * Compact scan bar — a prop-driven sibling of the Hero's scan form.
 *
 * Why this exists: search intent for "test my website speed" (~2,800
 * impressions/quarter as of 2026-09) wants a tool with an input box, not an
 * article. The speed-test blog post ranks for those terms but earned 0 clicks
 * because the searcher lands on prose. This puts the input box on the post.
 *
 * Reuses the Hero's proven markup and the same dual-channel handoff to the
 * Audit island (sessionStorage for "not hydrated yet" + a `pb:prefill-url`
 * custom event for "already hydrated"), so there's no second React island and
 * no duplicated scan logic. On a page with no #audit section it falls back to
 * navigating to /free-website-audit, which picks the URL up on mount.
 */
interface Props {
  eyebrow?: string;
  heading?: string;
  note?: string;
  buttonLabel?: string;
  /** Plausible custom-prop value, so scans from here are attributable. */
  location?: string;
  /** Heading tag — keep the page's single h1 on the post title. */
  headingLevel?: "h2" | "h3";
}

const {
  eyebrow = "Free · no email needed",
  heading = "Test your website speed now.",
  note = "Real Google Lighthouse scores for speed, mobile, SEO and accessibility, in plain English.",
  buttonLabel = "Scan my site",
  location = "blog-scanbar",
  headingLevel = "h2",
}: Props = Astro.props;

const Heading = headingLevel;
---

<aside class="scanbar" aria-label="Free website speed test">
  <span class="scanbar-eyebrow eyebrow-chip">
    <span class="eyebrow-dot"></span>
    {eyebrow}
  </span>

  <Heading class="scanbar-heading">{heading}</Heading>

  <form class="scanbar-form hero-scan-form" action="#audit">
    <label class="hero-scan-label" for="scanbar-url">Your website URL</label>
    <input
      id="scanbar-url"
      class="hero-scan-input scanbar-input"
      type="text"
      inputmode="url"
      autocomplete="url"
      placeholder="yourbusiness.ca"
    />
    <button
      type="submit"
      class={`btn-mint btn-interactive hero-scan-btn plausible-event-name=Scan+Started plausible-event-location=${location}`}
    >
      {buttonLabel}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>
  </form>

  <p class="scanbar-note">{note}</p>
</aside>

<style>
  .scanbar {
    margin: 0 0 40px;
    padding: clamp(22px, 3vw, 30px) clamp(20px, 3vw, 32px);
    background: var(--color-mint-50);
    border: 1px solid var(--color-mint-200);
    border-radius: var(--radius-card, 20px);
  }

  .scanbar-heading {
    margin: 14px 0 6px;
    font-size: clamp(21px, 2vw, 27px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  /* The form inherits .hero-scan-form/.hero-scan-input/.hero-scan-btn from
     Hero.astro's scoped styles, which don't reach here — restate only the
     layout bits those provide. Visuals still come from the btn-mint utility. */
  .scanbar-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: stretch;
    margin-top: 16px;
    max-width: 100%;
  }
  .scanbar-form :global(.hero-scan-label) {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .scanbar-input {
    flex: 1 1 240px;
    min-width: 0;
    font-family: inherit;
    font-size: 16px;
    padding: 14px 22px;
    background: var(--color-paper);
    border: 1.5px solid var(--color-ink);
    border-radius: 9999px;
    outline: none;
    color: var(--color-ink);
  }
  .scanbar-input::placeholder { color: var(--color-ink-400); }
  .scanbar-input:focus {
    border-color: var(--color-mint-500);
    box-shadow: 0 0 0 4px var(--color-mint-100);
  }
  .scanbar-form :global(.hero-scan-btn) {
    font-family: inherit;
    cursor: pointer;
    flex: none;
    justify-content: center;
  }

  .scanbar-note {
    margin: 14px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-ink-500);
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .scanbar-form :global(.hero-scan-btn) { flex: 1 1 100%; }
  }
</style>

<script>
  // Same dual-channel handoff as Hero.astro: sessionStorage covers the island
  // not being hydrated yet (client:visible), the custom event covers it already
  // being mounted. Kept in sync with Hero.astro's script deliberately — both
  // feed the one Audit island via the same `pb:prefill-url` contract.
  document.querySelectorAll<HTMLFormElement>(".scanbar-form").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>(".scanbar-input");
      const value = input?.value.trim() ?? "";
      if (value) {
        sessionStorage.setItem("pb_hero_url", value);
        window.dispatchEvent(new CustomEvent("pb:prefill-url", { detail: value }));
      }
      const target = document.getElementById("audit");
      if (!target) {
        // No Audit island on this page — the prefill is stored, so the audit
        // page's island picks it up on mount.
        window.location.href = "/free-website-audit";
        return;
      }
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
    });
  });
</script>
